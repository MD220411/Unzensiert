{
  "steps": [
    { "name": "Syntax and ASCII of the scripts", "builtin": "powershell-syntax" },
    { "name": "Tests", "command": "powershell -NoProfile -ExecutionPolicy Bypass -File tests\\Run-Tests.ps1" },
    { "name": "Facts (facts\\facts.json against documentation and code)", "command": "python -B scripts\\check_facts.py", "needs": "python", "optional": true },
    { "name": "Linter (PSScriptAnalyzer)", "command": "powershell -NoProfile -Command \"$r = @(Invoke-ScriptAnalyzer -Path . -Recurse -Severity Error,Warning); $r | Format-Table -AutoSize; exit [int]($r.Count -gt 0)\"", "needs": "Invoke-ScriptAnalyzer", "optional": true }
  ]
}
