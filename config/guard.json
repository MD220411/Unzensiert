  "commandRules": [
    {
      "id": "disk-format",
      "decision": "deny",
      "pattern": "(^|[\\s;&|(\"'])(format(\\.com)?\\s+[a-z]:|diskpart\\b|mkfs(\\.\\w+)?\\s|Format-Volume\\b|Clear-Disk\\b|Initialize-Disk\\b|Remove-Partition\\b)|\\bdd\\s[^|;&]*\\bof=[\"']?(\\\\\\\\\\.\\\\|/dev/(sd|nvme|hd))",
      "reason": "Formatting or overwriting a drive"
    },
    {
      "id": "boot-and-backups",
      "decision": "deny",
      "pattern": "\\b(bcdedit|bootrec|bcdboot)\\b|\\bvssadmin(\\.exe)?\\s+(delete|resize)|\\bwbadmin(\\.exe)?\\s+delete|\\bcipher(\\.exe)?\\s+/w|\\bsdelete(64)?(\\.exe)?\\b|\\bwmic\\s+shadowcopy\\s+delete|\\bRemove-CimInstance\\b[^|;&]*ShadowCopy",
      "reason": "Changing the boot configuration, shadow copies or backups"
    },
    {
      "id": "registry-change",
      "decision": "ask",
      "pattern": "\\breg(\\.exe)?\\s+(delete|add|import|restore|unload)\\b|\\b(Remove-Item|Remove-ItemProperty|Set-ItemProperty|New-ItemProperty|New-Item|ri|rm|sp)\\b[^|;&]*\\b(HKLM|HKCU|HKCR|HKU|Registry)::?",
      "reason": "Changing the Windows registry"
    },
    {
      "id": "security-off",
      "decision": "ask",
      "pattern": "\\bSet-MpPreference\\b[^|;&]*-Disable|\\bAdd-MpPreference\\b[^|;&]*-Exclusion|\\bnetsh(\\.exe)?\\s+(advfirewall|firewall)\\b[^|;&]*\\b(off|disable)\\b|\\bSet-NetFirewallProfile\\b[^|;&]*-Enabled\\s+\\$?False|\\bSet-ExecutionPolicy\\b[^|;&]*-Scope\\s+(LocalMachine|CurrentUser)|\\bnet1?(\\.exe)?\\s+(user|localgroup)\\b[^|;&]*/add\\b|\\b(New-LocalUser|Add-LocalGroupMember)\\b|\\bDisable-WindowsOptionalFeature\\b|\\bsc(\\.exe)?\\s+(delete|config)\\s",
      "reason": "Changing the antivirus, firewall, user accounts or services"
    },
    {
      "id": "autostart",
      "decision": "ask",
      "pattern": "\\bschtasks(\\.exe)?\\s+[/-](create|change)\\b|\\b(Register-ScheduledTask|Set-ScheduledTask|New-Service|Register-WmiEvent|Register-CimIndicationEvent)\\b|CurrentVersion\\\\+Run(Once)?\\b|Start Menu\\\\+Programs\\\\+Startup|GetFolderPath\\(\\s*['\\\"]?(Common)?Startup|\\bsetx(\\.exe)?\\s|\\[(System\\.)?Environment\\]::SetEnvironmentVariable\\([^)]*['\\\"]?(User|Machine)['\\\"]?\\s*\\)|\\bgit\\s+config\\s+[^|;&]*--(global|system)\\s+[^|;&]*(hookspath|alias\\.|pager|editor|sshcommand|fsmonitor|credential|filter\\.|diff\\.|include|insteadof|\\.helper|\\.program)|\\b(npm|pnpm|yarn)\\s+config\\s+set\\s+[^|;&]*script-shell|\\b(code|cursor)(\\.cmd)?\\s+[^|;&]*--install-extension|(>>?|\\btee\\b|\\bsed\\s+-i|\\bcp\\b|\\bmv\\b|\\bAdd-Content\\b|\\bSet-Content\\b|\\bOut-File\\b|\\bCopy-Item\\b|\\bMove-Item\\b)[^|;&]*(\\.bashrc|\\.bash_profile|\\.bash_login|[\\\\/~]\\.profile\\b|\\.zshrc|\\$PROFILE\\b|[\\\\/]\\.gitconfig|Microsoft\\.PowerShell_profile|[\\\\/]profile\\.ps1)",
      "reason": "Something that starts a program permanently, at sign-in or with every shell"
    },
    {
      "id": "shutdown",
      "decision": "ask",
      "pattern": "(^|[\\s;&|(\"'])(shutdown(\\.exe)?\\s+[/-][srhpl]\\b|Restart-Computer\\b|Stop-Computer\\b|logoff(\\.exe)?(\\s|$))",
      "reason": "Shutting down, restarting or signing out"
    },
    {
      "id": "download-and-run",
      "decision": "ask",
      "pattern": "\\b(curl|wget)(\\.exe)?\\b[^;&]*\\|\\s*(sudo\\s+)?(ba|z|da)?sh\\b|\\b(iwr|irm|Invoke-WebRequest|Invoke-RestMethod|curl|wget)\\b[^;&]*\\|\\s*(iex|Invoke-Expression)\\b|\\b(iex|Invoke-Expression)\\b[^;&|]*\\b(iwr|irm|Invoke-WebRequest|Invoke-RestMethod|DownloadString|Net\\.WebClient)\\b|\\bDownloadString\\s*\\([^)]*\\)\\s*\\|\\s*(iex|Invoke-Expression)|\\b(ba)?sh\\s+<\\(\\s*(curl|wget)\\b|\\bmshta(\\.exe)?\\s+https?:|\\bregsvr32\\b[^;&|]*/i:https?:|\\b(curl|wget)(\\.exe)?\\b[^;&\\n]*\\|\\s*(sudo\\s+)?(python[\\d.]*|py|node|perl|ruby|php|pwsh|powershell)(\\.exe)?\\s*(-\\s*)?($|[;&|\\n])|\\b(eval|source|\\.|(ba|z|da)?sh\\s+-c)\\s+[\"']?\\$\\(\\s*(curl|wget)\\b|\\b(curl|wget|iwr|irm|Invoke-WebRequest)(\\.exe)?\\b[^\\n]*\\s(-o|-O|--output|-OutFile)\\s+[\"']?(?<file>[\\w./\\\\~$-]+)[\"']?[^\\n]*[;&\\n]\\s*(sudo\\s+|&\\s*)?((ba|z|da)?sh|python[\\d.]*|py|node|powershell(\\.exe)?[^;&\\n]*-File|\\.|source|start|chmod\\s+\\S+)?\\s*[\"']?(\\./|\\.\\\\)?\\k<file>",
      "reason": "Downloading a program and running it at once"
    },
    {
      "id": "git-discard",
      "decision": "ask",
      "pattern": "\\bgit\\b[^|;&]*\\s(reset\\s+(--hard|--merge)|clean\\s+(-[a-z]*f|--force)|checkout\\s+(-f|--force|(--\\s+)?\\.(\\s|$))|restore\\s+(--staged\\s+)?(--worktree\\s+)?\\.(\\s|$)|stash\\s+(drop|clear)|branch\\s+-D\\b|reflog\\s+expire|filter-branch|update-ref\\s+-d)",
      "reason": "A git command that throws away unsaved work or history"
    },
    {
      "id": "git-force-push",
      "decision": "ask",
      "pattern": "\\bgit\\b[^|;&]*\\spush\\b[^|;&]*(\\s--force(?!-with-lease)\\b|\\s-[a-z]*f[a-z]*(\\s|$)|\\s--mirror\\b|\\s--delete\\b|\\s\\+\\S+)",
      "reason": "A git push that overwrites or deletes the state on the server"
    },
    {
      "id": "credential-tools",
      "decision": "ask",
      "pattern": "\\bcmdkey(\\.exe)?\\s+/list|\\bvaultcmd\\b|\\bGet-StoredCredential\\b|\\bgh\\s+auth\\s+(token|refresh|login|setup-git)\\b|\\bgh\\s+auth\\s+status\\b[^|;&]*(--show-token|\\s-t\\b)|\\bgit\\s+credential(-manager)?\\s+(fill|get)\\b|\\bsecurity\\s+find-(generic|internet)-password\\b|\\bnetsh\\s+wlan\\s+show\\s+profile\\b[^|;&]*key\\s*=\\s*clear|\\bProtectedData\\]?::Unprotect\\b|\\bgit-credential-manager(\\.exe)?\\s+(get|fill)\\b",
      "reason": "Reading stored credentials"
    },
    {
      "id": "secret-paths",
      "decision": "ask",
      "pattern": "[\\\\/]\\.ssh[\\\\/](?!known_hosts|[\\w.-]+\\.pub\\b|config\\b)[\\w.*?-]+|[\\\\/]\\.ssh\\b(?![\\\\/])|[\\\\/]\\.aws[\\\\/]|[\\\\/]\\.git-credentials\\b|[\\\\/]\\.claude[\\\\/]\\.cred|[\\\\/]\\.gnupg[\\\\/]|[\\\\/][._]netrc\\b|[\\\\/]\\.docker[\\\\/]config\\.json|[\\\\/]\\.kube[\\\\/]config|[\\\\/]GitHub CLI[\\\\/]|[\\\\/]\\.pypirc\\b|[\\\\/]\\.vault-token\\b|User Data[\\\\/][^|;&]*(Login Data|Cookies|Local State)|Firefox[\\\\/]Profiles[\\\\/][^|;&]*(logins\\.json|key4\\.db|cookies\\.sqlite)|\\.kdbx\\b|[\\\\/]run[\\\\/]api|ConsoleHost_history",
      "reason": "Access to keys, passwords or credentials"
    },
    {
      "id": "guard-files",
      "decision": "ask",
      "pattern": "(guard\\.json|readonly\\.json|machine\\.json|trust\\.json|GuardRules\\.ps1|PathRules\\.ps1|DeleteRules\\.ps1|TrustRules\\.ps1|GitRules\\.ps1|Guard-Tool\\.ps1|HookEnvironment\\.ps1|Check-Stop\\.ps1|CommandRules\\.ps1)[^\\n]*(>|\\btee\\b|\\bsed\\b|\\bcp\\b|\\bmv\\b|\\brm\\b|\\bdel\\b|Set-Content|Add-Content|Out-File|Copy-Item|Move-Item|Remove-Item|New-Item|WriteAllText|\\bpython|\\bnode\\b)|(>|\\btee\\b|\\bsed\\s+-i|\\bcp\\b|\\bmv\\b|\\brm\\b|\\bdel\\b|Set-Content|Add-Content|Out-File|Copy-Item|Move-Item|Remove-Item|New-Item|WriteAllText)[^|;&\\n]*(guard\\.json|readonly\\.json|machine\\.json|trust\\.json|GuardRules\\.ps1|PathRules\\.ps1|DeleteRules\\.ps1|TrustRules\\.ps1|GitRules\\.ps1|Guard-Tool\\.ps1|HookEnvironment\\.ps1|Check-Stop\\.ps1|CommandRules\\.ps1)|\\bunzensiert(\\.cmd|\\.ps1)?['\\\"]?\\s[^|;&]*(--permission-mode|--dangerously|--trust\\b|--updates?\\b|--allowed-?tools)",
      "reason": "A change to the protection of Unzensiert itself, or a start of it with other rights"
    },
    {
      "id": "publish",
      "decision": "ask",
      "pattern": "\\bgh(\\.exe)?\\s+(release\\s+(create|delete|edit|upload|delete-asset)|repo\\s+(create|delete|edit|rename|archive|transfer|deploy-key)|secret|variable|ssh-key|gpg-key|workflow\\s+(run|enable|disable)|gist\\s+(create|edit|delete)|ruleset|api\\b[^|;&]*(\\s-X\\s*|\\s--method[\\s=]+)['\\\"]?(POST|PUT|PATCH|DELETE)|api\\b[^|;&]*\\s(-f|-F|--field|--raw-field|--input)\\b)|\\b(npm|pnpm|yarn|bun)\\s+publish\\b|\\btwine\\s+upload\\b|\\b(uv|poetry|flit|hatch)\\s+publish\\b|\\bcargo\\s+publish\\b|\\bgem\\s+push\\b|\\b(docker|podman)\\s+push\\b|\\bdotnet\\s+nuget\\s+push\\b|\\bvsce\\s+publish\\b|\\bPublish-(Module|Script|PSResource)\\b",
      "reason": "Publishing something, or changing settings, in your name"
    },
    {
      "id": "clipboard",
      "decision": "ask",
      "pattern": "\\b(Get|Set)-Clipboard\\b|(^|[\\s;&|(])(clip|xclip|xsel|pbpaste|pbcopy)(\\.exe)?(\\s|$)|/dev/clipboard|Windows\\.Clipboard",
      "reason": "Reading or changing the clipboard, which often holds passwords"
    },
    {
      "id": "delete-by-code",
      "decision": "ask",
      "pattern": "(shutil\\.rmtree|\\brmSync\\b|\\brimraf\\b|\\brm_rf\\b|FileUtils\\.rm|File::Path|IO\\.Directory\\]::Delete|DeleteFolder|\\bos\\.removedirs)[^\\n]*(expanduser|homedir|USERPROFILE|HOMEPATH|\\$HOME|\\bHOME\\b|Path\\.home|[A-Z]:[\\\\/]+(Users|Windows|Program))|(expanduser|homedir|USERPROFILE|\\$HOME|Path\\.home)[^\\n]*(shutil\\.rmtree|\\brmSync\\b|\\brimraf\\b|IO\\.Directory\\]::Delete)",
      "reason": "Code that deletes a whole folder of the user or of the system"
    },
    {
      "id": "encoded-command",
      "decision": "ask",
      "pattern": "\\b(powershell|pwsh)(\\.exe)?\\b[^|;&\\n]*\\s-e(n|nc|nco|ncod|ncode|ncoded|ncodedc\\w*|c)?\\s+['\\\"]?[A-Za-z0-9+/=]{16,}|\\bbase64\\s+(-d|--decode|-D)\\b[^;&\\n]*\\|\\s*(ba|z|da)?sh\\b|\\bFromBase64String\\b[^\\n]*(Invoke-Expression|\\biex\\b)|(Invoke-Expression|\\biex\\b)[^\\n]*FromBase64String",
      "reason": "A command whose real text is hidden in an encoding"
    }
  ]
}
