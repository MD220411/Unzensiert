    "ahead": "↑",
    "behind": "↓"
  },

  "texts": {
    "_comment": "{0}, {1} ... sind Platzhalter. Eine Liste (sprueche) heisst: jedes Mal ein anderer Text.",
    "tagline": "frei · lokal · unzensiert · bunt",
    "sprueche": [
      "Deine Karten, deine Regeln.",
      "Kein Filter. Keine Leine.",
      "Denk selbst. Bau selbst.",
      "Bunt ist kein Fehler.",
      "Freiheit läuft lokal.",
      "Hier zensiert keiner.",
      "Mal über den Rand.",
      "Code ist auch nur Farbe.",
      "Laut denken erlaubt.",
      "Jedes Zeichen zählt.",
      "Ausbrechen ist auch eine Richtung.",
      "Wer fragt, lernt.",
      "Die Wand gehört dir.",
      "Erst sprühen, dann denken. Oder umgekehrt."
    ],
    "farewell": "Sitzung vorbei nach {0}. Die Zeichen fliegen weiter.",
    "emberOn": "Frei seit {0} Uhr. Das Modell rechnet auf deinen eigenen Karten.",
    "emberOff": "Noch still. claude-local lässt es los.",
    "admin": "ADMIN",
    "exitCode": "Ende {0}",
    "context": "Kontext",
    "contextOf": "Kontext {0} von {1} Tokens",
    "limit5h": "5-h-Limit",
    "limitUntil": "bis {0}",
    "switchModel": "/model wechselt zwischen {0}"
  },

  "art": {
    "_comment": "Das Bild aus Zeichen: text steht ueber der Shell, bannerText vor jeder Sitzung von claude-local. Der Text wird mit font in Bloecke gesetzt, jeder Block mit einem zufaelligen Zeichen aus fill gefuellt und im Farbkreis eingefaerbt. Um die Buchstaben spruehen Zeichen aus spray (Wahrscheinlichkeit sprayChance), rechts davon brechen Zeichen aus und fliegen davon: erst aus fill, dann aus flightMid, am Ende aus flightFar (flightDensity, flightReach = Anteil der freien Breite). scale = groesste Verbreiterung, die passt; kleiner, wenn das Fenster schmal ist. Jedes Bild ist anders.",
    "text": "UNZENSIERT",
    "bannerText": "FREI",
    "scale": 2,
    "bannerScale": 2,
    "_details": "shadow = Zeichen des Schattens (rechts unten hinter den Buchstaben), light = wie stark die Buchstaben oben aufgehellt und unten abgedunkelt sind, dripBody/dripEnd/dripChance/dripLength = Farbnasen, die von den Unterkanten herunterlaufen, sparkle/sparkleChance = Funken im freien Raum, line = Zeichen der Sprühlinie unter dem Bild, cloudText = einfarbiges Bild vor einer Cloud-Sitzung (claude).",
    "fill": "UNZESIRT#@%&$WMXKB08",
    "spray": ".,:;'`~*+^",
    "flightMid": "+*=~^%<>/\\",
    "flightFar": ".,'`:°",
    "shadow": ":;.",
    "light": 0.38,
    "dripBody": "|!:",
    "dripEnd": "'.°",
    "dripChance": 0.11,
    "dripLength": 3,
    "sparkle": "✦✧*+",
