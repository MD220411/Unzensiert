{
  "_comment": "Look 'Night Shift' for the terminal, the shell, Claude Code, claude-local and Unzensiert: calm, warm, a workshop at night. Active when config\\style.json chooses it. After changes: scripts\\Install-Style.ps1. Description: docs\\style.md.",

  "name": "Night Shift",

  "modes": {
    "_comment": "Three moods of light. The colour temperature shows where the model runs: workbench = shell, ember = local model on your own GPUs, highbeam = Claude in the cloud.",
    "workbench": {
      "label": "Workbench",
      "mark": "●",
      "background": "#101318",
      "foreground": "#D8D0C2",
      "cursor": "#E9B44C",
      "accent": "#E9B44C",
      "accentSoft": "#9A7B3C",
      "dim": "#7C8491",
      "faint": "#3B424E"
    },
    "ember": {
      "label": "Ember",
      "mark": "●",
      "background": "#15100C",
      "foreground": "#E8DDCB",
      "cursor": "#FF8A3D",
      "accent": "#FF8A3D",
      "accentSoft": "#B5622E",
      "dim": "#93836F",
      "faint": "#43372B"
    },
    "highbeam": {
      "label": "High Beam",
      "mark": "◇",
      "background": "#0B1119",
      "foreground": "#D7E0EA",
      "cursor": "#9CC4E4",
      "accent": "#9CC4E4",
      "accentSoft": "#5F86A8",
      "dim": "#7B8899",
      "faint": "#2C3746"
    }
  },

  "ink": {
    "_comment": "Colours with a meaning, the same in every mood.",
    "ok": "#8DB87A",
    "warn": "#E9B44C",
    "error": "#E8604F",
    "ember": "#FF8A3D",
    "branch": "#8FB0D0"
  },

  "palette": {
    "_comment": "The 16 ANSI colours of the terminal (Windows Terminal scheme). Background, text and cursor come from modes.workbench.",
    "selectionBackground": "#2B3A4D",
    "black": "#171B22",
    "red": "#E0604F",
    "green": "#8DB87A",
    "yellow": "#E9B44C",
    "blue": "#6F9CCB",
    "purple": "#B58CB8",
    "cyan": "#73B7AE",
    "white": "#C9C2B5",
    "brightBlack": "#5C6573",
    "brightRed": "#F58268",
    "brightGreen": "#A9D194",
    "brightYellow": "#F6CE7A",
    "brightBlue": "#9CC4E4",
    "brightPurple": "#D2A9D0",
    "brightCyan": "#9AD4CA",
    "brightWhite": "#EFE9DD"
  },

  "glyphs": {
    "prompt": "»",
    "emberOff": "○",
    "gauge": "━",
    "sep": "·",
    "dirty": "±",
    "ahead": "↑",
    "behind": "↓"
  },

  "texts": {
    "_comment": "{0}, {1} ... are placeholders.",
    "emberOn": "The embers have been glowing since {0}.",
    "emberOff": "The embers are out. claude-local lights them.",
    "admin": "ADMIN",
    "exitCode": "Ende {0}",
    "context": "Kontext",
    "contextOf": "Kontext {0} von {1} Tokens",
    "limit5h": "5-h-Limit",
    "limitUntil": "bis {0}",
    "switchModel": "/model wechselt zwischen {0}"
  },

  "font": {
    "_comment": "face is used when it is installed (scripts\\Install-Font.ps1), otherwise fallback.",
    "face": "IBM Plex Mono",
    "fallback": "Cascadia Mono",
    "size": 11,
    "weight": "normal",
    "cellHeight": "1.3",
    "source": {
      "url": "https://github.com/IBM/plex/releases/download/%40ibm/plex-mono%402.5.0/ibm-plex-mono.zip",
      "pattern": "IBMPlexMono-*.ttf",
      "license": "SIL Open Font License 1.1"
    }
  },

  "terminal": {
    "_comment": "Windows Terminal: padding, cursor, tab row, window frame.",
    "padding": "20, 14, 20, 14",
    "cursorShape": "vintage",
    "cursorHeight": 22,
    "tabRow": "#0A0C10",
    "frame": "#5A431F",
    "frameUnfocused": "#1B1F26"
  },

  "shell": {
    "_comment": "mode = mood of the shell (an entry of modes).",
    "mode": "workbench",
    "greeting": true,
    "gaugeWidth": 16,
    "slowCommandSeconds": 2,
    "emberProcess": "llama-server",
    "syntax": {
      "_comment": "Colours of the input line (PSReadLine).",
      "Command": "#E9B44C",
      "Parameter": "#8FB0D0",
      "String": "#A9C48A",
      "Variable": "#E0A07A",
      "Number": "#D2A9D0",
      "Operator": "#7C8491",
      "Keyword": "#D98A6A",
      "Type": "#73B7AE",
      "Member": "#D8D0C2",
      "Comment": "#5C6573",
      "Default": "#D8D0C2",
      "Error": "#E8604F",
      "Emphasis": "#F6CE7A"
    }
  },

  "agent": {
    "_comment": "The agent Unzensiert (scripts\\lib\\AgentUi*.ps1, docs\\style.md): welcome, activity line, answer, tools, questions, the end of every request. Texts that do not belong to a style are in config\\unzensiert-texts.json, the activity words in claude.spinnerVerbs. Colours as #RRGGBB, \"rainbow\", \"shimmer\" (a light runs through) or \"accent\".",
    "title": "U N Z E N S I E R T",
    "_title": "Without a picture of characters (no section art) this name stands above the facts of the welcome.",
    "spinner": ["◐", "◓", "◑", "◒"],
    "spinnerInk": "accent",
    "verbInk": "shimmer",
    "doneVerbs": ["Forged", "Filed", "Hardened", "Soldered", "Fitted", "Measured", "Polished"],
    "marks": { "answer": "●", "thought": "∴", "corner": "⎿", "turn": "●", "stopped": "■", "thinking": "┊", "todoDone": "✓", "todoActive": "▸", "todoOpen": "□" },
    "notes": { "dim": "·", "ok": "✓", "warn": "!", "error": "✗" },
    "bullets": ["•", "◦", "▪"],
    "quote": "│",
    "box": "╭╰─│",
    "headingInk": "accent",
    "promptInk": "accent",
    "rule": "line",
    "trail": 0,
    "barRefreshSeconds": 5,
    "_bar": "The status bar under the text reads the graphics cards again every barRefreshSeconds while something runs (0 = only before every input).",
    "tools": {
      "_comment": "Sign and colour of every tool in its header line.",
      "Bash": { "icon": "❯", "ink": "#E9B44C" },
      "PowerShell": { "icon": "❯", "ink": "#8FB0D0" },
      "Read": { "icon": "≡", "ink": "#73B7AE" },
      "Edit": { "icon": "✎", "ink": "#FF8A3D" },
      "EditLines": { "icon": "✎", "ink": "#FF8A3D" },
      "Write": { "icon": "✚", "ink": "#A9C48A" },
      "Glob": { "icon": "⌕", "ink": "#D2A9D0" },
      "Grep": { "icon": "⌕", "ink": "#D2A9D0" },
      "TodoWrite": { "icon": "☰", "ink": "#D2A9D0" },
      "AskUserQuestion": { "icon": "?", "ink": "#E9B44C" },
      "PresentPlan": { "icon": "◆", "ink": "#A9C48A" },
      "WebSearch": { "icon": "◎", "ink": "#8FB0D0" },
      "WebFetch": { "icon": "⇣", "ink": "#73B7AE" }
    },
    "diffTint": 0.82,
    "diffStrong": 0.62
  },

  "claude": {
    "_comment": "Claude Code. themes are written to ~\\.claude\\themes\\<themePrefix><name>.json; the keys under overrides are the colour names of Claude Code.",
    "themePrefix": "nightshift-",
    "cloudMode": "highbeam",
    "localMode": "ember",
    "statusLine": {
      "gaugeWidth": 8,
      "localRefreshSeconds": 5,
      "contextWarnPercent": 70,
      "contextFullPercent": 90
    },
    "spinnerVerbs": [
      "Measuring",
      "Filing",
      "Forging",
      "Weighing it up",
      "Aligning",
      "Hardening",
      "Soldering",
      "Stoking the embers",
      "Tightening",
      "Grinding",
      "Taking a bearing",
      "Compacting",
      "Taking measure",
      "Holding it to the light",
      "Clamping",
      "Scribing",
      "Checking the fit",
      "Thinking it over"
    ],
    "themes": {
